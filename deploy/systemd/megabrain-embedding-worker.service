[Unit]
Description=MegaBrain embedding worker
After=megabrain.service

[Service]
Type=simple
WorkingDirectory=%h/megabrain
EnvironmentFile=%h/.config/megabrain/megabrain.env
Environment=MB_BASE_URL=http://127.0.0.1:4300
Environment=MB_API_TOKEN_FILE=%h/.config/megabrain/token
Environment=MB_EMB_SLEEP_S=0.05
Environment=MB_EMB_IDLE_SLEEP_S=30.0
Environment=MB_EMB_BATCH=64
Environment=MB_EMB_API_CHUNK=2
ExecStart=%h/megabrain/.venv/bin/python %h/megabrain/scripts/embedding_worker.py
Restart=on-failure
RestartSec=30
Nice=15
CPUQuota=300%
MemoryHigh=3G
MemoryMax=4G
TimeoutStopSec=600

[Install]
WantedBy=default.target
