# Fake values only; copy to .env and replace before production.
# Required
POSTGRES_PASSWORD=change-this-local-password
MEGABRAIN_DATABASE_URL=postgresql://megabrain@postgres:5432/megabrain
MEGABRAIN_API_TOKEN=change-me

# Optional defaults
MEGABRAIN_REDIS_URL=redis://redis:6379/0
MEGABRAIN_HOST=127.0.0.1
MEGABRAIN_PORT=4300
MEGABRAIN_DATA_DIR=./state
MEGABRAIN_MODEL_DIR=./models
MEGABRAIN_EMBEDDING_MODEL=BAAI/bge-m3
MEGABRAIN_CONSOLIDATION_MODEL=glm-5.3
# Optional agent/inference control-plane endpoint; memory core does not require it.
MEGABRAIN_ROUTER_URL=
