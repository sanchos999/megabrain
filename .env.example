# Fake values only; copy to .env and replace before production.
# Required
MEGABRAIN_DATABASE_URL=postgresql://megabrain@postgres:5432/megabrain
MEGABRAIN_API_TOKEN=change-me

# Optional defaults
MEGABRAIN_REDIS_URL=redis://redis:6379/0
MEGABRAIN_HOST=127.0.0.1
MEGABRAIN_PORT=4300
MEGABRAIN_DATA_DIR=./state
MEGABRAIN_MODEL_DIR=./models
MEGABRAIN_EMBEDDING_MODEL=Xenova/bge-m3
MEGABRAIN_CONSOLIDATION_MODEL=router-memory
MEGABRAIN_CONSOLIDATION_HEAVY_MODEL=router-memory-heavy
MB_CONSOLIDATION_TICK_S=60
MB_CONSOLIDATION_MIN_BATCH_EVENTS=20
MB_CONSOLIDATION_MAX_WAIT_S=1800
MB_CONSOLIDATION_COOLDOWN_S=900
MB_CONSOLIDATION_MAX_BATCH_EVENTS=100
MB_CONSOLIDATION_MAX_BATCH_TOKENS=12000
MB_CONSOLIDATION_MAX_COST_PER_CALL=0.50
MB_CONSOLIDATION_DAILY_BUDGET_USD=25
MB_CONSOLIDATION_MONTHLY_BUDGET_USD=250
MB_CONSOLIDATION_MAX_CALLS_PER_HOUR=2
MB_CONSOLIDATION_MAX_CALLS_PER_DAY=24
# Optional model-router V4 endpoint for consolidation inference.
MEGABRAIN_ROUTER_URL=http://127.0.0.1:4200
MODEL_ROUTER_API_KEY=replace-with-a-client-key
# Local BGE-M3 ONNX INT8 model directory. The embedding service auto-downloads
# the model on first start when this directory is incomplete.
MB_ONNX_MODEL_DIR=/home/sanchos/megabrain/models/bge-m3
MB_ONNX_THREADS=2
